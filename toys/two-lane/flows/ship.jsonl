{"flow": "ship", "domain": "westwind", "correlation": {"westwind.order.packed": "/order_id", "westwind.carrier.collected": "/order_id", "westwind.ship.overdue": "/order_id", "westwind.order.shipped": "/order_id", "westwind.order.cancelled": "/order_id", "westwind.address.changed": "/order_id"}, "row": "westwind_order", "ordering": "dependency", "needs": {"westwind.carrier.collected": ["westwind.order.packed"]}, "clock": ["westwind.address.changed", "westwind.order.cancelled"]}
