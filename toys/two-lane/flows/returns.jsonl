{"flow": "returns", "domain": "westwind", "correlation": {"westwind.return.authorized": "/ticket", "westwind.return.shipped": "/ticket", "westwind.returns.due": "/ticket"}, "row": "westwind_ticket", "ordering": "dependency", "needs": {"westwind.return.shipped": ["westwind.return.authorized"]}}
{"id": "authorized", "on": "westwind.return.authorized", "step": "host", "action": "remember_return", "next": "wait"}
{"id": "wait", "step": "after", "delay_ms": 1209600000, "type": "westwind.returns.due"}
